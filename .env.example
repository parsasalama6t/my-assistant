# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional settings (defaults shown)
# ASSISTANT_MODEL=claude-opus-5
# ASSISTANT_EFFORT=medium            # low | medium | high | xhigh | max
# ASSISTANT_USER_NAME=               # how the assistant addresses you
# ASSISTANT_DATA_DIR=~/.my-assistant # where the SQLite database lives
# ASSISTANT_WEB_SEARCH=1             # 1 to let the assistant search the web
# ASSISTANT_FALLBACKS=1              # 1 to enable server-side refusal fallbacks
# ASSISTANT_MAX_TOKENS=16000
