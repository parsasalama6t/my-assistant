# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional settings (defaults shown)
# ASSISTANT_MODEL=claude-opus-5
# ASSISTANT_EFFORT=medium            # low | medium | high | xhigh | max
# ASSISTANT_USER_NAME=               # how the assistant addresses you
# ASSISTANT_DATA_DIR=~/.my-assistant # where the SQLite database lives
# ASSISTANT_WEB_SEARCH=1             # 1 to let the assistant search the web
# ASSISTANT_FALLBACKS=1              # 1 to enable server-side refusal fallbacks
# ASSISTANT_MAX_TOKENS=16000

# Google Calendar + Gmail (run `my-assistant google login` after placing the OAuth client file)
# ASSISTANT_GOOGLE=1                 # 0 to ignore a stored Google login
# ASSISTANT_GOOGLE_CREDENTIALS=~/.my-assistant/google_credentials.json

# Timezone and scheduling (defaults shown). All times below are local HH:MM.
# ASSISTANT_TIMEZONE=America/Toronto  # IANA zone used for dates, reminders, and briefings
# ASSISTANT_MORNING_BRIEFING=07:30    # daily briefing text; leave empty to disable
# ASSISTANT_EVENING_REVIEW=21:00      # daily evening review text; leave empty to disable
# ASSISTANT_EVENT_LEAD_MINUTES=15     # text this many minutes before calendar events
# ASSISTANT_TASK_LEAD_MINUTES=0       # text this many minutes before a task's due time
# ASSISTANT_CATCHUP_GRACE_MINUTES=120 # after this long, missed recurring/auto reminders are skipped
# ASSISTANT_TICK_SECONDS=30           # how often the daemon checks for due messages
# ASSISTANT_SESSION_IDLE_HOURS=12     # start a fresh chat session after this much silence

# Messaging: set up Telegram and/or Twilio so the assistant can text you.
# ASSISTANT_DEFAULT_CHANNEL=          # telegram | twilio; auto-picked from what's configured
# TELEGRAM_BOT_TOKEN=                 # from @BotFather
# TELEGRAM_CHAT_ID=                   # your chat id(s), comma-separated; the first gets scheduled texts
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=                        # SMS sender number (E.164); leave empty to use WhatsApp only
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886  # Twilio WhatsApp sender (sandbox by default)
# TWILIO_WEBHOOK_URL=                 # public URL Twilio posts inbound messages to
# TWILIO_WEBHOOK_PORT=8081
# USER_PHONE=                         # your number in E.164, e.g. +14165550100
